DISCORD_BOT_TOKEN={token}
APPLICATION_ID={appId}

# Optional comma-separated allowlists for all paid AI commands and mentions.
# Empty values allow members of any server where the bot is installed.
AI_ALLOWED_GUILD_IDS=
AI_ALLOWED_USER_IDS=

OPENAI_API_KEY={key}
OPENAI_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1

IMAGE_PROVIDER=openai

GOOGLE_API_KEY={key}
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

TTS_PROVIDER={piper}
PIPER_HOST={address}
PIPER_PORT={10200}
